modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[[deployment.responseHeaders]]
path = "/images/ui/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["spotify:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 22896
externalPort = 3000

[[ports]]
localPort = 23425
externalPort = 3001

[[ports]]
localPort = 23426
externalPort = 3002

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_DOMAIN = "2c9a03d2-eafd-4979-ac97-d1ce5b78ab33-00-3j3tn0ye60cnr-hro5uy1p.riker.replit.dev"
YOUTUBE_INTRADAY_SHADOW_AUTOMATION_DISABLED = "false"
SONGSTATS_HISTORY_VALIDATION_EXPECTED_SOURCE_FINGERPRINT = "b106190efb4d3f26a2dde49d64ad2c427120c5a1551d00cffc9bb67f71bf4df5"
SONGSTATS_HISTORY_VALIDATION_HTTP_ENABLED = "false"
SONGSTATS_HISTORY_TARGET_ENVIRONMENT = "production-validation"
SONGSTATS_HISTORY_PRODUCTION_VALIDATION_APPROVED = "true"
