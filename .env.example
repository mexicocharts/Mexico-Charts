# Server-only Songstats credentials. Never prefix these with VITE_.
SONGSTATS_API_KEY=

# Optional: falls back to SPOTIFY_ADMIN_KEY or YOUTUBE_ADMIN_KEY when omitted.
SONGSTATS_ADMIN_KEY=

# Hard monthly safety ceiling matching the enterprise agreement. The code
# refuses values above 529 even if this environment variable is misconfigured.
SONGSTATS_MONTHLY_UNIQUE_ARTIST_LIMIT=529

# Daily current-stat snapshots for the approved catalog.
SONGSTATS_SNAPSHOT_AUTOMATION=true
SONGSTATS_SNAPSHOT_HOUR_UTC=11

# Mexico Charts $6/month artist-monitoring checkout. Server-only.
# Create a Stripe account, copy its restricted/live secret key here, and keep
# the key out of VITE_ variables and client code.
STRIPE_SECRET_KEY=
PUBLIC_SITE_URL=https://mexicochart.com

# Optional fan listening connections. Keep every secret server-only.
# LASTFM_API_KEY enables Last.fm username validation and scrobble history.
LASTFM_API_KEY=
# This redirect URI must also be registered exactly in Spotify's dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_USER_REDIRECT_URI=https://mexicochart.com/api/account/connections/spotify/callback
# A separate random value of at least 32 characters used to sign OAuth state
# and encrypt user Spotify tokens before database storage.
MUSIC_CONNECTION_SECRET=
