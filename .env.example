# Server-only Songstats credentials. Never prefix these with VITE_.
SONGSTATS_API_KEY=

# Optional: falls back to SPOTIFY_ADMIN_KEY or YOUTUBE_ADMIN_KEY when omitted.
SONGSTATS_ADMIN_KEY=

# Keep the free integration capped at 25. Raise to 529 only with the production key.
SONGSTATS_SYNC_MAX_ARTISTS=25

# Opt in only after a successful manual test sync.
SONGSTATS_SNAPSHOT_AUTOMATION=false
SONGSTATS_SNAPSHOT_HOUR_UTC=11
