{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:artist-images": "../../scripts/node_modules/.bin/tsx ./src/scripts/audit-artist-images.ts",
    "songstats-history-backfill": "../../scripts/node_modules/.bin/tsx ./src/scripts/songstats-history-backfill.ts",
    "test:songstats-history": "../../scripts/node_modules/.bin/tsx --test ./src/lib/songstats-history-model.test.ts ./src/lib/monitoring-history.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.52",
    "@replit/connectors-sdk": "^0.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "compression": "1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "openai": "^6.37.0",
    "pino": "^9",
    "pino-http": "^10",
    "youtubei.js": "17.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
